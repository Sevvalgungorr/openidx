# OpenIDX Environment Configuration
# Copy this file to .env and fill in the values.
# Run `./scripts/generate-secrets.sh` to auto-generate a .env with random secrets.

# ----- Environment -----
APP_ENV=development
LOG_LEVEL=debug

# ----- Database -----
# Password for PostgreSQL. Used by both the postgres container and service connection strings.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
DATABASE_URL=postgres://openidx:${POSTGRES_PASSWORD}@localhost:5432/openidx?sslmode=disable
# TLS for PostgreSQL. Defaults to 'disable' for local dev; the docker-compose
# connection strings honor ${DATABASE_SSL_MODE:-disable}. Production MUST use
# 'require', 'verify-ca', or 'verify-full' (services running with APP_ENV=production
# refuse to start when this is 'disable'). With verify-* set the corresponding
# cert paths below.
DATABASE_SSL_MODE=disable
# DATABASE_SSL_ROOT_CERT=/etc/openidx/certs/pg-ca.crt
# DATABASE_SSL_CERT=/etc/openidx/certs/pg-client.crt   # mTLS only
# DATABASE_SSL_KEY=/etc/openidx/certs/pg-client.key    # mTLS only

# ----- Redis -----
# Password for Redis. Used by the redis container and service connection strings.
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ----- Elasticsearch -----
ELASTICSEARCH_URL=http://localhost:9200

# ----- SIEM forwarder (audit-service) -----
# Stream the unified audit trail to an external SIEM. Inert unless enabled.
# AUDIT_SIEM_ENABLED=true
# AUDIT_SIEM_FORMAT=syslog            # syslog | cef | hec
# AUDIT_SIEM_ENDPOINT=siem.example:514 # host:port (syslog/cef) or full URL (hec)
# AUDIT_SIEM_TLS=true                 # TLS for the syslog/cef TCP connection
# AUDIT_SIEM_INSECURE_SKIP_VERIFY=false
# AUDIT_SIEM_TOKEN=                   # Splunk HEC token (hec format only)
# AUDIT_SIEM_HOSTNAME=                # syslog HOSTNAME field (defaults to OS hostname)
# AUDIT_SIEM_POLL_SECONDS=5
# AUDIT_SIEM_BATCH_SIZE=200

# ----- OPA -----
OPA_URL=http://localhost:8281

# ----- Security -----
# Secret used to sign JWTs. Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
# AES-256 encryption key. Must be exactly 32 bytes (characters).
ENCRYPTION_KEY=CHANGE_ME_exactly_32_bytes_long!

# ----- Public web app -----
# Externally reachable origin of the end-user web app. Used to build the links
# mailed to users: password reset, email verification, and invitations.
# MUST be set in any real deployment — otherwise those links point at localhost
# and the flows are unusable. This is the browser app, not the API origin.
PUBLIC_BASE_URL=http://localhost:3000

# ----- OAuth / OIDC -----
OAUTH_ISSUER=http://localhost:8006
OAUTH_JWKS_URL=http://oauth-service:8006/.well-known/jwks.json

# ----- Frontend -----
VITE_API_URL=http://localhost:8088
VITE_OAUTH_URL=http://localhost:8006
VITE_OAUTH_CLIENT_ID=admin-console
VITE_AUTH_PROVIDER=openidx

# ----- Observability -----
# Grafana admin password (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# ----- Zero Trust Network (Ziti) -----
# Ziti controller admin password (login: admin / $ZITI_PWD at the ZAC console)
ZITI_PWD=CHANGE_ME_ziti_admin_password
# Browser-facing URL of the bundled ZAC admin console. Leave unset to derive
# <ZITI_CTRL_URL>/zac/; the dev compose overrides it for the 11280 port mapping.
#ZITI_CONSOLE_URL=

# ----- Access Proxy -----
# Session signing secret for the access proxy. Must be at least 32 characters.
ACCESS_SESSION_SECRET=CHANGE_ME_access_session_secret_32

# ----- Guacamole -----
# Guacamole admin password for remote desktop gateway
GUACAMOLE_ADMIN_PASSWORD=CHANGE_ME_guacamole_admin_password

# ----- SMTP (optional) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openidx.io
