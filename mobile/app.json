{
  "expo": {
    "name": "OpenIDX",
    "slug": "openidx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openidx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.tdv.openidx",
      "associatedDomains": [
        "webcredentials:openidx.tdv.org",
        "applinks:openidx.tdv.org"
      ]
    },
    "android": {
      "package": "org.tdv.openidx",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "openidx.tdv.org",
              "pathPrefix": "/oauth-callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenIDX uses the camera to scan authenticator QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OpenIDX uses Face ID to securely authenticate you."
        }
      ],
      "expo-notifications",
      "./plugins/withCertPinning.js",
      "./plugins/withCertPinningIOS.js",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://openidx.tdv.org",
      "oauthClientId": "openidx-mobile",
      "oauthScopes": "openid profile email offline_access",
      "certPinning": {
        "host": "openidx.tdv.org",
        "expiration": "2027-01-01",
        "pins": [
          "sha256/pcThjmVDuiW/+iCA4QbfaMz0t+We+JcD98PAaL1d744=",
          "sha256/cGuxAXyFXFkWm61cF4HPWX8S0srS9j0aSqN0k4AP+4A="
        ]
      },
      "eas": {
        "projectId": "85309726-2127-4a01-bc4f-2836ffd62687"
      }
    }
  }
}
