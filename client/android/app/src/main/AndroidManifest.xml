<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Committed on purpose. `flutter create` generates a vanilla manifest with
      NO package-visibility <queries> (so on Android 11+ url_launcher cannot see
      / open a browser) and NO custom-scheme intent-filter (so the OAuth redirect
      openidx://oauth-callback can't return to the app). Because `flutter create`
      does not overwrite existing files, this hand-written manifest wins.

      Package/applicationId is com.example.openidx_client, matching
      `flutter create` with project-name openidx_client; keep .MainActivity in sync.
    -->

    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Android 11 (API 30) package visibility: without this, url_launcher's
      canLaunch/launchUrl for an https:// URL returns false because the app can't
      "see" any browser. This declares intent to open BROWSABLE VIEW/https.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <application
        android:label="OpenIDX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Displays an Android View that continues showing the launch screen
                 Drawable until Flutter paints its first frame, then this is
                 replaced with the standard theme. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <!-- Standard launcher intent-filter. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              Custom-scheme deep link for the OAuth redirect. The server 302s to
              openidx://oauth-callback?code=…&state=…; this routes it back to the
              app, where app_links delivers it to the login flow. autoVerify is
              false because a custom scheme cannot be App-Links-verified.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="openidx" android:host="oauth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
